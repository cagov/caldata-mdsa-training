# Copy to .env and `source .env` before running Terraform or dbt locally.
# .env is git-ignored. Never commit real credentials.

# --- Terraform (Snowflake provider) authenticates as YOUR admin user ---
export SNOWFLAKE_ACCOUNT="MYORG-ABC12345"
export SNOWFLAKE_USER="YOUR_ADMIN_USER"
export SNOWFLAKE_PRIVATE_KEY_PATH="$HOME/.snowflake/your_admin_key.p8"
export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE="your-admin-key-passphrase"

# --- dbt local runs authenticate as the dbt SERVICE user ---
# When validating dbt locally, switch SNOWFLAKE_USER/key to the service account:
#   export SNOWFLAKE_USER="DBT_SVC_USER_DEV"
#   export SNOWFLAKE_PRIVATE_KEY_PATH="$HOME/.snowflake/dbt_svc_dev.p8"
#   export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE="your-dbt-key-passphrase"
export SNOWFLAKE_ROLE="TRANSFORMER_DEV"
export SNOWFLAKE_WAREHOUSE="TRANSFORMING_XS_DEV"
export DBT_TRAINING_DB="TRAINING_DEV"
